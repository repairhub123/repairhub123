rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidJob(data) {
      return data.ID is string && data.ID.size() <= 20 &&
             data.Name is string && data.Name.size() <= 100 &&
             (data.Phone == null || (data.Phone is string && data.Phone.size() <= 20)) &&
             (data.Model == null || (data.Model is string && data.Model.size() <= 50)) &&
             (data.Work == null || (data.Work is string && data.Work.size() <= 200)) &&
             (data.Cost is number) &&
             (data.Amount is number) &&
             (data.Profit is number) &&
             (data.Percentage is number) &&
             (data.Share is number) &&
             data.Status in ['Pending', 'Completed'] &&
             (data.received_date is string) &&
             (data.received_time is string) &&
             (data.completed_date is string) &&
             (data.completed_time is string) &&
             (data.Photo == null || (data.Photo is string && data.Photo.size() <= 500)) &&
             (data.technician_share is number) &&
             (data.boss_share is number) &&
             (data.added_by == null || (data.added_by is string && data.added_by.size() <= 50));
    }

    match /jobs/{jobId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidJob(incoming()) && incoming().ID == jobId;
      allow update: if isSignedIn() && isValidJob(incoming()) && (
        // Action: Mark Completed
        (incoming().diff(existing()).affectedKeys().hasOnly(['Status', 'completed_date', 'completed_time'])) ||
        // Action: Full Edit
        (incoming().diff(existing()).affectedKeys().hasAny(['Name', 'Phone', 'Model', 'Work', 'Cost', 'Amount', 'Percentage', 'Photo', 'Profit', 'Share', 'technician_share', 'boss_share']))
      );
      allow delete: if isSignedIn(); // Allow deletion for now as some apps might need it
    }
  }
}
